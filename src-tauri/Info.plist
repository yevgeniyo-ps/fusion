<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged by Tauri into the app's Info.plist. CFBundleIconName names the icon in
     Resources/Assets.car (scripts/app-icon.sh): without it, macOS 26 shows the .icns on a
     white plate. -->
<plist version="1.0">
<dict>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
</dict>
</plist>
